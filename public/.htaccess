# For Apache hosting (cPanel, GoDaddy shared, most shared hosts). The
# Cloudflare Pages and Netlify equivalent is `_headers` beside this file; both
# are committed so the folder can be copied to any host unchanged.
#
# Apple rejects the association file unless it is served as JSON, and the file
# has no extension, so Apache sends it as text/plain by default and the link
# fails silently — the tap just opens the browser (P2-F6).
<Files "apple-app-site-association">
  ForceType application/json
</Files>

# Never rewrite or redirect these two paths. Apple refuses to follow a redirect
# for the association file, including a plain apex-to-www one, and a landing
# page's rewrite rules are the usual thing that swallows them.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# A tapped invite link reaches the browser whenever the app isn't installed
# (P2-F6). 404.html reads the code out of the path itself and shows it, rather
# than a dead end. Cloudflare Pages and Netlify serve 404.html automatically
# with no config; Apache needs telling.
ErrorDocument 404 /404.html
