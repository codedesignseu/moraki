{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "design",
    // Deno entry points (Edge Functions): Deno globals and jsr: imports. Their
    // pure modules, e.g. apple-revoke/apple.ts, stay checked.
    "supabase/functions/*/index.ts"
  ]
}
