{
  "expo": {
    "name": "Moraki",
    "slug": "moraki",
    "scheme": "moraki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["assets/**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "eu.codedesigns.moraki",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:moraki.app"],
      "usesAppleSignIn": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "eu.codedesigns.moraki",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "moraki.app",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.865433627932-oq6tjkh24r7d9hc0le0f9or4q7bfhde6"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "ce-code-designs-ltd",
          "project": "moraki",
          "url": "https://de.sentry.io/"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#E9EDE6",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#131814"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "eaf90151-3528-4c56-b283-4a813a7e822f"
      }
    },
    "owner": "ce-code-designs-ltd",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/eaf90151-3528-4c56-b283-4a813a7e822f",
      "fallbackToCacheTimeout": 0
    }
  }
}
