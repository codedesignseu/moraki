# Moraki — environment template
# Copy to .env in the project root and fill in locally. .env is gitignored.
# Never commit real values, and never paste them into chat, a doc, or a commit message.

# ── App bundle (Expo inlines EXPO_PUBLIC_* at build time: these ship in the app) ──
# Read by src/sync/supabaseEnv.ts. Only these two belong in the app.
#
# Local development: run `supabase start`, then `supabase status` prints the
# API URL (http://127.0.0.1:55321: Moraki moves off the CLI's default ports,
# see supabase/config.toml) and the local publishable key.
#
# Hosted project: Supabase dashboard > Project Settings > API Keys. Use the new
# key format (sb_publishable_…), not the legacy anon JWT; the app refuses
# anything else, and refuses a secret key outright.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-side only: CI, edge functions, scripts. Never EXPO_PUBLIC_, never in app code ──
# Supabase dashboard > Project Settings > API Keys > Secret keys (sb_secret_…).
SUPABASE_SECRET_KEY=

# Expo / EAS — expo.dev > Account Settings > Access Tokens. Needed by P0-09.
EXPO_TOKEN=

# Apple — filled in once enrollment clears (P0-09).
APPLE_TEAM_ID=
