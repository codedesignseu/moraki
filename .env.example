# Moraki — environment template
# Copy this to .env in the project root once Claude Code scaffolds it at P0-01.
# .env is gitignored from the first commit — never commit real values.
# Never paste real values from this file into chat, a doc, or a commit message.

# Expo / EAS — from expo.dev > Account Settings > Access Tokens
# (Generate a fresh one; the first one was pasted in chat and should be revoked.)
EXPO_TOKEN=8s-B8n5vlglS-LBUBYc1V1Yp90Gk-hihdYtq2VjM

# Supabase — from your moraki-staging project, Settings > API > API Keys
# Use the NEW key format (sb_publishable_..., sb_secret_...), not the legacy
# anon/service_role JWT keys — Supabase is deprecating anon/service_role by
# end of 2026, and there's no reason to build a new project on the old ones.
# If the dashboard still shows "Legacy API keys" by default, switch to the
# "API Keys" tab that shows sb_publishable_ / sb_secret_.
EXPO_PUBLIC_SUPABASE_URL=https://tjcahnjpbkgrjytrazfs.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qfWHJ30EPe5zYfZJmA3v8w_HgjU7DGQ

# Secret key — server-side / CI / edge functions only.
# Never referenced from app code, never bundled into a build.
SUPABASE_SECRET_KEY=sb_secret_eV9awDQ3rw0sV3YIRB1EyQ_IC5-nTwr

# Apple — filled in once enrollment clears (needed by P0-09, not before)
APPLE_TEAM_ID=

# Google Play — filled in closer to P4, not needed yet
# (left blank intentionally)
