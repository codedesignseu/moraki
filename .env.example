# Moraki — environment template
# Copy to .env in the project root and fill in locally. .env is gitignored.
# Never commit real values, and never paste them into chat, a doc, or a commit message.

# ── App bundle (Expo inlines EXPO_PUBLIC_* at build time: these ship in the app) ──
# Read by src/sync/supabaseEnv.ts. Only these two belong in the app.
#
# Local development: run `supabase start`, then `supabase status` prints the
# API URL (http://127.0.0.1:55321: Moraki moves off the CLI's default ports,
# see supabase/config.toml) and the local publishable key.
#
# Hosted project: Supabase dashboard > Project Settings > API Keys. Use the new
# key format (sb_publishable_…), not the legacy anon JWT; the app refuses
# anything else, and refuses a secret key outright.
#
# Sign-in codes come from whichever project these two point at, so keep both
# from the same one. Against the local stack, read codes at
# http://localhost:55324 (Moraki's mail catcher; not the CLI's usual 54324).
# From a phone, use the Mac's LAN address for both, e.g.
# http://192.168.x.x:55321 and http://192.168.x.x:55324: on the phone,
# localhost is the phone. The hosted project still sends a magic link rather
# than a code until its email templates are updated (P2-F5).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-side only: CI, edge functions, scripts. Never EXPO_PUBLIC_, never in app code ──
# Supabase dashboard > Project Settings > API Keys > Secret keys (sb_secret_…).
SUPABASE_SECRET_KEY=

# Expo / EAS — expo.dev > Account Settings > Access Tokens. Needed by P0-09.
EXPO_TOKEN=

# Apple — filled in once enrollment clears (P0-09).
APPLE_TEAM_ID=

# ── Crash reporting (P4-08). Optional: with no DSN the app reports nothing ──
# Sentry, EU region only — the app refuses to start on a DSN that is not an
# *.ingest.de.sentry.io host (SDD 12.1 keeps every processor in the EU).
# Sentry dashboard > Settings > Projects > <project> > Client Keys (DSN).
# A DSN is public by design (it only allows sending events), so it belongs
# with the other EXPO_PUBLIC_ values.
EXPO_PUBLIC_SENTRY_DSN=
# Which build the events come from: development, preview or production.
EXPO_PUBLIC_SENTRY_ENV=
