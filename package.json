{
  "name": "moraki",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "babel-preset-expo": "~57.0.0",
    "drizzle-orm": "^0.45.3",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sql.js": "^1.14.2",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "jest",
    "test:tz": "for tz in Europe/Nicosia UTC America/New_York; do echo \"TZ=$tz\"; TZ=$tz EXPECTED_TZ=$tz jest --ci --verbose || exit 1; done"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "jest-expo"
  }
}
